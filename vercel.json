{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fitfeed-4kn3.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://fitfeed-4kn3.onrender.com/socket.io/:path*"
    },
    { "handle": "filesystem" },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}